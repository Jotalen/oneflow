# Nessie v2 (Capital One) — server only, never NEXT_PUBLIC_
NESSIE_API_KEY=nsk_xxx
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
# LLM: stub (default, deterministic, no key) | gemini
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Webhook (only when deployed on HTTPS)
NESSIE_WEBHOOK_SECRET=
NEXT_PUBLIC_DOMAIN=localhost:3000
# Fallback LLM when Gemini is busy (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Tiger Data (TimescaleDB) — balance history; panel hidden when unset
DATABASE_URL=

# Optional: browser-accessible Solana Devnet RPC URL. Defaults to the public Devnet endpoint.
# This value is public; use only a browser-restricted provider key, never a server secret.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
